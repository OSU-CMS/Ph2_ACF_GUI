##
identify
# COMMAND
keysighte3633a -S identify
# OUTPUT
HEWLETT-PACKARD,E3633A,0,SIM1.0
# RETURNS 0
##
reset
# COMMAND
keysighte3633a -S reset
# OUTPUT

# RETURNS 0
##
voltage
# COMMAND
keysighte3633a -S voltage 1
# OUTPUT
0.0
# RETURNS 0
##
voltage invalid output
# COMMAND
keysighte3633a -S voltage 5
# OUTPUT
ChannelError: Channel 5 does not exist or is not enabled on this device.
# RETURNS 1
##
voltage unmasked output
# COMMAND
keysighte3633a -S -O 2 voltage 2
# OUTPUT
0.0
# RETURNS 0
##
set voltage
# COMMAND
keysighte3633a -S voltage 1 5.0
# OUTPUT
5.0
# RETURNS 0
##
set voltage prohibited
# COMMAND
keysighte3633a -S voltage 1 500.0
# OUTPUT
ValidationError: Value 500.0 does not pass verifier _is_numeric for set() on setting VOLTAGE for device KeysightE3633A.
Allowable values: Numbers in range [-50:50]
# RETURNS 1
##
current
# COMMAND
keysighte3633a -S current 1
# OUTPUT
0.0
# RETURNS 0
##
set current
# COMMAND
keysighte3633a -S current 1 0.2
# OUTPUT
0.2
# RETURNS 0
