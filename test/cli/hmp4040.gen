identify               | hmp4040 -S identify
reset                  | hmp4040 -S reset
voltage                | hmp4040 -S voltage 1
voltage invalid output | hmp4040 -S voltage 5
voltage masked output  | hmp4040 -S -O 2 voltage 3
set voltage            | hmp4040 -S voltage 2 5.0
set voltage prohibited | hmp4040 -S voltage 3 500.0
current                | hmp4040 -S current 2
set current            | hmp4040 -S current 3 0.2
measure                | hmp4040 -S measure 4
activate               | hmp4040 -S activate 2
deactivate             | hmp4040 -S deactivate 3
activated              | hmp4040 -S activated
activated channel      | hmp4040 -S activated 3
status                 | hmp4040 -S status
off                    | hmp4040 -S off
on                     | hmp4040 -S on
ovp                    | hmp4040 -S ovp 2
ovp set                | hmp4040 -S ovp 3 3.0
generic query          | hmp4040 -S query status_byte
ramp voltage           | hmp4040 -S ramp_voltage 1 10 -s 3 -d 0 -m
ramp voltage negative  | hmp4040 -S ramp_voltage 1 -s 5 -d 0 -m -- -20
ramp current           | hmp4040 -S ramp_current 1 10 -s 3 -d 0 -m
scpi query             | hmp4040 -S scpi_query "*ESR?"
#scpi write             | hmp4040 -S scpi_write "*ESE 0"
