##
identify
# COMMAND
hmp4040 -S identify
# OUTPUT
ROHDE&SCHWARZ,HMP4040,000000,SIM1.0
# RETURNS 0
##
reset
# COMMAND
hmp4040 -S reset
# OUTPUT

# RETURNS 0
##
voltage
# COMMAND
hmp4040 -S voltage 1
# OUTPUT
0.0
# RETURNS 0
##
voltage invalid output
# COMMAND
hmp4040 -S voltage 5
# OUTPUT
Usage: hmp4040 voltage [OPTIONS] CHANNEL [VOLTAGE]
Try 'hmp4040 voltage --help' for help.

Error: Invalid value for 'CHANNEL': '5' is not one of '1', '2', '3', '4'.
# RETURNS 2
##
voltage masked output
# COMMAND
hmp4040 -S -O 2 voltage 3
# OUTPUT
ChannelError: channel 3 does not exist or is not enabled on this device.
# RETURNS 1
##
set voltage
# COMMAND
hmp4040 -S voltage 2 5.0
# OUTPUT
5.0
# RETURNS 0
##
set voltage prohibited
# COMMAND
hmp4040 -S voltage 3 500.0
# OUTPUT
ValidationError: Value 500.0 does not pass verifier _is_numeric for set() on setting VOLTAGE for device HMP4040.
Allowable values: Numbers in range [-32:32]
# RETURNS 1
##
current
# COMMAND
hmp4040 -S current 2
# OUTPUT
0.0
# RETURNS 0
##
set current
# COMMAND
hmp4040 -S current 3 0.2
# OUTPUT
0.2
# RETURNS 0
