##
ramp voltage
# COMMAND
hmp4040 -S ramp_voltage 1 10 -s 3 -d 0 -m
# OUTPUT
(10.0, [[{TIMESTAMP}, 0.00012098, 2.1e-07], [{TIMESTAMP}, 0.00012098, 2.1e-07], [{TIMESTAMP}, 0.00012098, 2.1e-07], [{TIMESTAMP}, 0.00012098, 2.1e-07], [{TIMESTAMP}, 0.00012098, 2.1e-07]])
# RETURNS 0
##
ramp voltage negative
# COMMAND
hmp4040 -S ramp_voltage 1 -s 5 -d 0 -m -- -20
# OUTPUT
(-20.0, [[{TIMESTAMP}, 0.00012098, 2.1e-07], [{TIMESTAMP}, 0.00012098, 2.1e-07], [{TIMESTAMP}, 0.00012098, 2.1e-07], [{TIMESTAMP}, 0.00012098, 2.1e-07], [{TIMESTAMP}, 0.00012098, 2.1e-07]])
# RETURNS 0
##
ramp current
# COMMAND
hmp4040 -S ramp_current 1 10 -s 3 -d 0 -m
# OUTPUT
(10.0, [[{TIMESTAMP}, 0.00012098, 2.1e-07], [{TIMESTAMP}, 0.00012098, 2.1e-07], [{TIMESTAMP}, 0.00012098, 2.1e-07], [{TIMESTAMP}, 0.00012098, 2.1e-07], [{TIMESTAMP}, 0.00012098, 2.1e-07]])
# RETURNS 0
